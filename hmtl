<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MLBB Diamond Store</title>
    <style>
        :root {
            --bg-color: #0b0e14;
            --card-bg: #151b22;
            --accent-color: #f39c12;
            --text-main: #ffffff;
            --text-sub: #8b949e;
            --success-color: #238636;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 15px;
        }
        .container {
            max-width: 450px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 20px;
        }
        header h1 {
            color: var(--accent-color);
            margin: 0 0 5px 0;
            font-size: 24px;
        }
        header p {
            color: var(--text-sub);
            margin: 0;
            font-size: 14px;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid #30363d;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .card h2 {
            font-size: 16px;
            margin-top: 0;
            margin-bottom: 12px;
            color: var(--accent-color);
        }
        label {
            display: block;
            font-size: 13px;
            color: var(--text-sub);
            margin-bottom: 5px;
        }
        input {
            width: 100%;
            padding: 10px;
            margin-bottom: 12px;
            background-color: #0d1117;
            border: 1px solid #30363d;
            border-radius: 6px;
            color: #fff;
            font-size: 15px;
            box-sizing: border-box;
        }
        input:focus {
            outline: none;
            border-color: var(--accent-color);
        }
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .product-item {
            background-color: #0d1117;
            border: 2px solid #30363d;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s ease;
        }
        .product-item.selected {
            border-color: var(--accent-color);
            background-color: #1f242c;
        }
        .product-item h3 {
            margin: 0 0 5px 0;
            font-size: 14px;
        }
        .product-item p {
            margin: 0;
            color: var(--accent-color);
            font-weight: bold;
            font-size: 15px;
        }
        .btn-buy {
            width: 100%;
            background-color: var(--success-color);
            color: white;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 5px;
        }
        .btn-buy:active {
            opacity: 0.8;
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>⚡ MLBB Diamond Store</h1>
            <p>Instant WhatsApp & UPI Checkout</p>
        </header>

        <!-- Player Identification Card -->
        <div class="card">
            <h2>1. Enter Your Game Details</h2>
            <label for="userId">Mobile Legends User ID</label>
            <input type="number" id="userId" placeholder="e.g. 12345678" required>

            <label for="zoneId">Zone ID / Server ID</label>
            <input type="number" id="zoneId" placeholder="e.g. 3021" required>
        </div>

        <!-- Product Selection Card -->
        <div class="card">
            <h2>2. Select Diamond Package</h2>
            <div class="grid">
                <div class="product-item" onclick="selectProduct(this, 'Weekly Pass', '₹159')">
                    <h3>Weekly Pass</h3>
                    <p>₹159</p>
                </div>
                <div class="product-item" onclick="selectProduct(this, '86 Diamonds', '₹85')">
                    <h3>86 Diamonds</h3>
                    <p>₹85</p>
                </div>
                <div class="product-item" onclick="selectProduct(this, '172 Diamonds', '₹170')">
                    <h3>172 Diamonds</h3>
                    <p>₹170</p>
                </div>
                <div class="product-item" onclick="selectProduct(this, '257 Diamonds', '₹255')">
                    <h3>257 Diamonds</h3>
                    <p>₹255</p>
                </div>
            </div>
        </div>

        <!-- Checkout Action Button -->
        <button class="btn-buy" onclick="checkout()">Proceed to WhatsApp Checkout</button>
    </div>

    <script>
        let chosenItem = "";
        let chosenPrice = "";

        function selectProduct(element, name, price) {
            document.querySelectorAll('.product-item').forEach(item => {
                item.classList.remove('selected');
            });
            element.classList.add('selected');
            chosenItem = name;
            chosenPrice = price;
        }

        function checkout() {
            let userId = document.getElementById('userId').value.trim();
            let zoneId = document.getElementById('zoneId').value.trim();

            if (!userId || !zoneId) {
                alert("Please enter both your User ID and Zone ID.");
                return;
            }
            if (!chosenItem) {
                alert("Please select a diamond package.");
                return;
            }

            // CHANGE THIS TO YOUR WHATSAPP NUMBER (Country code + number, no + sign)
            let myWhatsAppNumber = "919876543210"; 

            let text = `Hello, I want to buy MLBB Diamonds:%0a%0a` +
                       `*Package:* ${chosenItem} (${chosenPrice})%0a` +
                       `*User ID:* ${userId}%0a` +
                       `*Zone ID:* ${zoneId}`;

            let url = `https://wa.me/${myWhatsAppNumber}?text=${text}`;
            window.open(url, '_blank');
        }
    </script>

</body>
</html>
